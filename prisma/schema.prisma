generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password reset — only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Platform models ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Teacher relations
  createdCourses Course[]     @relation("TeacherCourses")
  assignments    Assignment[] @relation("TeacherAssignments")

  // Student relations
  enrollments Enrollment[]
  progress    LessonProgress[]

  // Teacher-level subscriptions
  subscriptions Subscription[] @relation("UserSubscriptions")
  subscribers   Subscription[] @relation("UserSubscribers")

  // Content moderation
  contentReports ContentReport[] @relation("UserContentReports")

  // Account deletion requests (operator-actioned)
  deletionRequests DeletionRequest[]
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  published   Boolean  @default(false)
  subject     Subject
  keyStage    KeyStage
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  lessons     Lesson[]
  assignments Assignment[]
}

enum Subject {
  MATHS
  ENGLISH
  SCIENCE
  HISTORY
  GEOGRAPHY
  COMPUTING
  ART
  MUSIC
  PE
  RE
  MFL
}

enum KeyStage {
  KS1 // Years 1–2, ages 5–7
  KS2 // Years 3–6, ages 7–11
  KS3 // Years 7–9, ages 11–14
  KS4 // Years 10–11, ages 14–16
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, order])
}

model Assignment {
  id        String    @id @default(cuid())
  courseId  String
  teacherId String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  course      Course       @relation(fields: [courseId], references: [id])
  teacher     User         @relation("TeacherAssignments", fields: [teacherId], references: [id])
  enrollments Enrollment[]
}

model Enrollment {
  id           String   @id @default(cuid())
  studentId    String
  assignmentId String
  enrolledAt   DateTime @default(now())

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
}

// A user subscribing to another user (teacher-level), granting access to all
// of that teacher's published courses.
model Subscription {
  id           String   @id @default(cuid())
  subscriberId String
  teacherId    String
  subscribedAt DateTime @default(now())

  subscriber User @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  teacher    User @relation("UserSubscribers", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, teacherId])
  @@index([teacherId])
  @@index([subscriberId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  student User   @relation(fields: [studentId], references: [id])
  lesson  Lesson @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}

// A user's report of a course or lesson, queued for operator review. No
// automated action is taken in v1. contentType ('course' | 'lesson'),
// category and status are validated in app code (`src/lib/report-content.ts`).
// onDelete: SetNull — the report is retained for safeguarding when the
// reporter's account is deleted; only the reporter link is nulled.
model ContentReport {
  id          String   @id @default(cuid())
  reporterId  String?
  contentId   String
  contentType String
  category    String   @default("other")
  reason      String   @db.Text
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User? @relation("UserContentReports", fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([reporterId, contentType, contentId])
  @@index([contentType, contentId])
  @@index([status])
}

// A user's request to delete their own account, queued for an operator to
// action. Nothing is erased automatically in v1. status ('pending' | ...) is
// validated in app code (`src/lib/account-deletion.ts`).
// @@unique([userId, status]) guarantees at most one pending request per user,
// which backs the idempotent request flow.
// onDelete: Cascade — chosen deliberately: a DeletionRequest is a request
// about an account, so once the account is gone there is nothing left to
// action and the request is removed with it (contrast ContentReport, which is
// retained for safeguarding).
model DeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  requestedAt DateTime  @default(now())
  status      String    @default("pending")
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, status])
  @@index([status])
}
