# Copy to .env and fill in values.

# Prisma Postgres — get from console.prisma.io → your project → Connection Details
DATABASE_URL="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# App URL — update to your tunnel URL when using Cloudflare Tunnel
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated extra origins for Next.js Server Actions (no protocol, no trailing slash)
# Set to your tunnel hostname when using Cloudflare Tunnel, e.g.:
# ALLOWED_ORIGINS="random-words.trycloudflare.com"
# ALLOWED_ORIGINS="learn.yourdomain.com"
ALLOWED_ORIGINS=""

# ─── Optional: Google / Microsoft sign-in ─────────────────────────────────────
# Each provider is disabled (button hidden) until ALL of its variables are set.
# Never commit real values — set them in your local .env or deployment secrets.
# Only the openid, email and profile scopes are requested.
# Redirect URI to register with each provider: <NEXTAUTH_URL>/api/auth/callback/<provider-id>

# Google Workspace for Education — Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID (Web application). Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 — Microsoft Entra admin center → App registrations → New registration.
# Redirect URI (Web): <NEXTAUTH_URL>/api/auth/callback/microsoft-entra-id
# MICROSOFT_TENANT_ID is your school's Directory (tenant) ID. To link existing
# password accounts, enable the optional `xms_edov` ID-token claim so Microsoft
# reports verified email domains (otherwise linking is refused).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
